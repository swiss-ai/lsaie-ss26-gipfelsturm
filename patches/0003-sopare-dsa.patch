+def sparse_dsa_reference_fn(query, key, value, topk_indices, softmax_scale):
+    """
+    True sparse PyTorch DSA implementation.
+
+    This computes attention only over topk_indices, but it is still unfused:
+    it materializes selected_k, selected_v, and scores as PyTorch tensors.
+    """
+    sq, b, np, hn = query.size()
+    skv = key.size(0)
+    hnv = value.size(3)
+    topk = topk_indices.size(-1)
+
+    q = query.permute(1, 2, 0, 3).contiguous()
+    k = key.permute(1, 2, 0, 3).contiguous()
+    v = value.permute(1, 2, 0, 3).contiguous()
+
+    idx = topk_indices[:, None, :, :].expand(b, np, sq, topk)
+
+    gather_idx_k = idx.unsqueeze(-1).expand(b, np, sq, topk, hn)
+    k_expanded = k[:, :, None, :, :].expand(b, np, sq, skv, hn)
+    selected_k = torch.gather(k_expanded, dim=3, index=gather_idx_k)
+
+    gather_idx_v = idx.unsqueeze(-1).expand(b, np, sq, topk, hnv)
+    v_expanded = v[:, :, None, :, :].expand(b, np, sq, skv, hnv)
+    selected_v = torch.gather(v_expanded, dim=3, index=gather_idx_v)
+
+    scores = (q.unsqueeze(-2).float() * selected_k.float()).sum(dim=-1) * softmax_scale
+
+    q_positions = torch.arange(sq, device=query.device).view(1, 1, sq, 1)
+    causal_invalid = idx > q_positions
+    scores = scores.masked_fill(causal_invalid, float("-inf"))
+
+    probs = F.softmax(scores, dim=-1, dtype=torch.float32).to(value.dtype)
+    out = (probs.unsqueeze(-1) * selected_v).sum(dim=-2)
+
+    out = out.permute(2, 0, 1, 3).contiguous()
+    out = out.reshape(sq, b, np * hnv)
+
+    return out
+
+
+def _next_power_of_2(x: int) -> int:
+    return 1 << (x - 1).bit_length()
+
+
+@triton.jit
+def _triton_dsa_forward_1q_kernel(
+    Q,
+    K,
+    V,
+    TOPK,
+    OUT,
+    SQ: tl.constexpr,
+    SKV: tl.constexpr,
+    B: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    DV: tl.constexpr,
+    TOPK_K: tl.constexpr,
+    SCALE: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_DV: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    """
+    Simple fused DSA forward kernel.
+
+    One Triton program computes one output vector for one (query position, batch, head).
+
+    Q:    [SQ, B, H, D]
+    K:    [SKV, B, H, D]
+    V:    [SKV, B, H, DV]
+    TOPK: [B, SQ, TOPK_K]
+    OUT:  [SQ, B, H, DV]
+    """
+    q_pos = tl.program_id(0)
+    bh = tl.program_id(1)
+
+    b = bh // H
+    h = bh - b * H
+
+    offs_d = tl.arange(0, BLOCK_D)
+    offs_dv = tl.arange(0, BLOCK_DV)
+    offs_k = tl.arange(0, BLOCK_K)
+
+    q_ptrs = Q + q_pos * B * H * D + b * H * D + h * D + offs_d
+    q_vec = tl.load(q_ptrs, mask=offs_d < D, other=0.0).to(tl.float32)
+
+    topk_ptrs = TOPK + b * SQ * TOPK_K + q_pos * TOPK_K + offs_k
+    selected_idx = tl.load(topk_ptrs, mask=offs_k < TOPK_K, other=0)
+
+    k_ptrs = (
+        K
+        + selected_idx[:, None] * B * H * D
+        + b * H * D
+        + h * D
+        + offs_d[None, :]
+    )
+    k_tile = tl.load(
+        k_ptrs,
+        mask=(offs_k[:, None] < TOPK_K)
+        & (selected_idx[:, None] < SKV)
+        & (offs_d[None, :] < D),
+        other=0.0,
+    ).to(tl.float32)
+
+    scores = tl.sum(k_tile * q_vec[None, :], axis=1) * SCALE
+
+    valid = (offs_k < TOPK_K) & (selected_idx < SKV) & (selected_idx <= q_pos)
+    scores = tl.where(valid, scores, -float("inf"))
+
+    max_score = tl.max(scores, axis=0)
+    exp_scores = tl.exp(scores - max_score)
+    exp_scores = tl.where(valid, exp_scores, 0.0)
+    denom = tl.sum(exp_scores, axis=0)
+    probs = tl.where(denom > 0.0, exp_scores / denom, 0.0)
+
+    v_ptrs = (
+        V
+        + selected_idx[:, None] * B * H * DV
+        + b * H * DV
+        + h * DV
+        + offs_dv[None, :]
+    )
+    v_tile = tl.load(
+        v_ptrs,
+        mask=(offs_k[:, None] < TOPK_K)
+        & (selected_idx[:, None] < SKV)
+        & (offs_dv[None, :] < DV),
+        other=0.0,
+    )
+
+    acc = tl.sum(probs[:, None] * v_tile.to(tl.float32), axis=0)
+
+    out_ptrs = OUT + q_pos * B * H * DV + b * H * DV + h * DV + offs_dv
+    tl.store(out_ptrs, acc, mask=offs_dv < DV)
+
+
+def triton_dsa_forward_fn(query, key, value, topk_indices, softmax_scale):
+    """
+    Fused Triton DSA forward.
+
+    query:       [sq, b, np, hn]
+    key:         [skv, b, np, hn]
+    value:       [skv, b, np, hnv]
+    topk_indices:[b, sq, topk]
+    returns:     [sq, b, np * hnv]
+    """
+    query = query.contiguous()
+    key = key.contiguous()
+    value = value.contiguous()
+    topk_indices = topk_indices.contiguous()
+
+    sq, b, np, hn = query.shape
+    skv = key.shape[0]
+    hnv = value.shape[3]
+    topk = topk_indices.shape[-1]
+
+    if topk_indices.dtype != torch.long:
+        topk_indices = topk_indices.long()
+
+    block_d = _next_power_of_2(hn)
+    block_dv = _next_power_of_2(hnv)
+    block_k = _next_power_of_2(topk)
+
+    if block_d > 256 or block_dv > 256 or block_k > 256:
+        raise RuntimeError(
+            f"Triton DSA simple kernel block too large: "
+            f"BLOCK_D={block_d}, BLOCK_DV={block_dv}, BLOCK_K={block_k}. "
+            f"Use DSA_KERNEL_IMPL=sparse_ref for this configuration."
+        )
+
+    out = torch.empty((sq, b, np, hnv), device=query.device, dtype=value.dtype)
+    grid = (sq, b * np)
+
+    _triton_dsa_forward_1q_kernel[grid](
+        query,
+        key,
+        value,
+        topk_indices,
+        out,
+        SQ=sq,
+        SKV=skv,
+        B=b,
+        H=np,
+        D=hn,
+        DV=hnv,
+        TOPK_K=topk,
+        SCALE=float(softmax_scale),
+        BLOCK_D=block_d,
+        BLOCK_DV=block_dv,
+        BLOCK_K=block_k,
+        num_warps=4,
+    )
+
+    return out.reshape(sq, b, np * hnv)
+
+
+class TritonDSAForwardWithReferenceBackward(torch.autograd.Function):
+    """
+    Use Triton for the forward pass and sparse PyTorch reference for backward.
+
+    This is intended as the first fused milestone. It avoids forward intermediates,
+    but training performance can still be bottlenecked by the reference backward.
+    """
+
+    @staticmethod
+    def forward(ctx, query, key, value, topk_indices, softmax_scale):
+        ctx.save_for_backward(query, key, value, topk_indices)
+        ctx.softmax_scale = softmax_scale
+        return triton_dsa_forward_fn(query, key, value, topk_indices, softmax_scale)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        query, key, value, topk_indices = ctx.saved_tensors
+        softmax_scale = ctx.softmax_scale
+
+        with torch.enable_grad():
+            q = query.detach().requires_grad_(True)
+            k = key.detach().requires_grad_(True)
+            v = value.detach().requires_grad_(True)
+            out = sparse_dsa_reference_fn(q, k, v, topk_indices, softmax_scale)
+
+        dq, dk, dv = torch.autograd.grad(
+            out,
+            (q, k, v),
+            grad_output,
+            retain_graph=False,
+            allow_unused=False,
+        )
+
+        return dq, dk, dv, None, None
+
+
+def triton_dsa_autograd_fn(query, key, value, topk_indices, softmax_scale):
+    return TritonDSAForwardWithReferenceBackward.apply(
+        query, key, value, topk_indices, softmax_scale
+    )
+
